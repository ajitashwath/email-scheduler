NODE_ENV=development
PORT=4000

# Postgres — matches docker/docker-compose.yml defaults
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox_scheduler?schema=public"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session signing — set this to a long random string
JWT_SECRET=replace-this-with-a-long-random-string

FRONTEND_URL=http://localhost:3000

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Slack OAuth — create an app at https://api.slack.com/apps with the
# "incoming-webhook" and "chat:write" scopes, redirect URL below.
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_VERIFICATION_TOKEN=your-slack-verification-token
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Ethereal defaults (real per-sender creds are generated automatically on
# first login / via the seed script — these are just fallback config)
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587

# Optional real/configured SMTP sender
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=sender@example.com

# Elasticsearch — matches docker/docker-compose.yml defaults
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=email_jobs

# Scheduler tuning
WORKER_CONCURRENCY=5
DEFAULT_DELAY_BETWEEN_EMAILS_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200

# Bull Board (/admin/queues) basic auth
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me
